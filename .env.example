PORT=4173
HOST=127.0.0.1

# Public website origin. Keep this set to the exact Vercel/custom domain.
PUBLIC_ORIGIN=https://assemble-room.vercel.app
# Stable HTTPS hostname routed by Cloudflare Tunnel to http://127.0.0.1:4173.
WS_PUBLIC_ORIGIN=https://api.example.com

OFFICE_NAME=Assemble HQ
ORG_NAME=Assemble

# Use the Supabase Session Pooler connection string for a long-running Node server.
# Keep this secret on the Mac mini. Do not put a Supabase service key in the UI repo.
DATABASE_URL=
SESSION_SECRET=
# Use demo only on localhost. Production mode always disables demo login.
AUTH_MODE=demo
ALLOWED_DOMAINS=your-company.com
ADMIN_EMAILS=admin@your-company.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional: set all three values to enable LiveKit meetings.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

MAX_MEMBERS=50
MAX_ONLINE=20
ROOM_CAPACITY=8
CHAT_RETENTION_DAYS=30
